{
  "log": {
    "loglevel": "warning"
  },
  "dns": {
    "servers": [
      {
        "address": "77.88.8.8",
        "domains": [
          "geosite:category-ru"
        ],
        "expectIPs": [
          "geoip:ru"
        ]
      },
      {
        "address": "https://dns.google/dns-query"
      },
      "localhost"
    ],
    "queryStrategy": "UseIPv4"
  },
  "inbounds": [
    {
      "tag": "socks-in",
      "listen": "127.0.0.1",
      "port": 10808,
      "protocol": "socks",
      "settings": {
        "udp": true,
        "auth": "noauth"
      },
      "sniffing": {
        "enabled": true,
        "destOverride": [
          "http",
          "tls",
          "quic"
        ]
      }
    },
    {
      "tag": "http-in",
      "listen": "127.0.0.1",
      "port": 10809,
      "protocol": "http",
      "sniffing": {
        "enabled": true,
        "destOverride": [
          "http",
          "tls",
          "quic"
        ]
      }
    }
  ],
  "outbounds": [
    {
      "tag": "ru-gate-primary",
      "protocol": "vless",
      "settings": {
        "vnext": [
          {
            "address": "vpn.example.ru",
            "port": 443,
            "users": [
              {
                "id": "UUID",
                "encryption": "none",
                "level": 0
              }
            ]
          }
        ]
      },
      "streamSettings": {
        "network": "xhttp",
        "security": "reality",
        "realitySettings": {
          "serverName": "vpn.example.ru",
          "fingerprint": "firefox",
          "publicKey": "PUBKEY_RU_PRIMARY",
          "shortId": "SID_RU_PRIMARY",
          "spiderX": "/"
        },
        "xhttpSettings": {
          "host": "vpn.example.ru",
          "path": "/assets/media/stream",
          "mode": "auto",
          "extra": {
            "xPaddingBytes": "100-1000",
            "xmux": {
              "maxConnections": "2-3",
              "maxConcurrency": 0,
              "cMaxReuseTimes": "64-128",
              "hMaxRequestTimes": "800-900",
              "hMaxReusableSecs": "1800-3000"
            }
          }
        },
        "sockopt": {
          "tcpFastOpen": true
        }
      }
    },
    {
      "tag": "ru-gate-backup",
      "protocol": "vless",
      "settings": {
        "vnext": [
          {
            "address": "vpn2.example.ru",
            "port": 443,
            "users": [
              {
                "id": "UUID",
                "encryption": "none",
                "level": 0
              }
            ]
          }
        ]
      },
      "streamSettings": {
        "network": "xhttp",
        "security": "reality",
        "realitySettings": {
          "serverName": "vpn2.example.ru",
          "fingerprint": "firefox",
          "publicKey": "PUBKEY_RU_BACKUP",
          "shortId": "SID_RU_BACKUP",
          "spiderX": "/"
        },
        "xhttpSettings": {
          "host": "vpn2.example.ru",
          "path": "/cdn/v3/segments",
          "mode": "auto",
          "extra": {
            "xPaddingBytes": "100-1000",
            "xmux": {
              "maxConnections": "2-3",
              "maxConcurrency": 0,
              "cMaxReuseTimes": "64-128",
              "hMaxRequestTimes": "800-900",
              "hMaxReusableSecs": "1800-3000"
            }
          }
        },
        "sockopt": {
          "tcpFastOpen": true
        }
      }
    },
    {
      "tag": "kz-direct",
      "protocol": "vless",
      "settings": {
        "vnext": [
          {
            "address": "kz.example.ru",
            "port": 8443,
            "users": [
              {
                "id": "UUID",
                "encryption": "none",
                "level": 0
              }
            ]
          }
        ]
      },
      "streamSettings": {
        "network": "xhttp",
        "security": "reality",
        "realitySettings": {
          "serverName": "kz.example.ru",
          "fingerprint": "firefox",
          "publicKey": "PUBKEY_KZ",
          "shortId": "SID_KZ",
          "spiderX": "/"
        },
        "xhttpSettings": {
          "host": "kz.example.ru",
          "path": "/static/chunk/data",
          "mode": "auto",
          "extra": {
            "xPaddingBytes": "100-1000",
            "xmux": {
              "maxConnections": "2-3",
              "maxConcurrency": 0,
              "cMaxReuseTimes": "8-16",
              "hMaxRequestTimes": "16-32",
              "hMaxReusableSecs": "60-120"
            }
          }
        },
        "sockopt": {
          "tcpFastOpen": true
        }
      }
    },
    {
      "tag": "de-direct",
      "protocol": "vless",
      "settings": {
        "vnext": [
          {
            "address": "de.example.ru",
            "port": 8443,
            "users": [
              {
                "id": "UUID",
                "encryption": "none",
                "level": 0
              }
            ]
          }
        ]
      },
      "streamSettings": {
        "network": "xhttp",
        "security": "reality",
        "realitySettings": {
          "serverName": "de.example.ru",
          "fingerprint": "firefox",
          "publicKey": "PUBKEY_DE",
          "shortId": "SID_DE",
          "spiderX": "/"
        },
        "xhttpSettings": {
          "host": "de.example.ru",
          "path": "/static/chunk/data",
          "mode": "auto",
          "extra": {
            "xPaddingBytes": "100-1000",
            "xmux": {
              "maxConnections": "2-3",
              "maxConcurrency": 0,
              "cMaxReuseTimes": "8-16",
              "hMaxRequestTimes": "16-32",
              "hMaxReusableSecs": "60-120"
            }
          }
        },
        "sockopt": {
          "tcpFastOpen": true
        }
      }
    },
    {
      "tag": "nl-direct-grpc",
      "protocol": "vless",
      "settings": {
        "vnext": [
          {
            "address": "nl.example.ru",
            "port": 2096,
            "users": [
              {
                "id": "UUID",
                "encryption": "none",
                "level": 0
              }
            ]
          }
        ]
      },
      "streamSettings": {
        "network": "grpc",
        "security": "reality",
        "realitySettings": {
          "serverName": "nl.example.ru",
          "fingerprint": "firefox",
          "publicKey": "PUBKEY_NL",
          "shortId": "SID_NL",
          "spiderX": "/"
        },
        "grpcSettings": {
          "serviceName": "grpc.content.v1.Stream",
          "multiMode": true,
          "idle_timeout": 60,
          "health_check_timeout": 20
        },
        "sockopt": {
          "tcpFastOpen": true
        }
      }
    },
    {
      "tag": "direct",
      "protocol": "freedom",
      "settings": {
        "domainStrategy": "UseIPv4"
      }
    },
    {
      "tag": "block",
      "protocol": "blackhole",
      "settings": {
        "response": {
          "type": "http"
        }
      }
    }
  ],
  "routing": {
    "domainStrategy": "IPIfNonMatch",
    "rules": [
      {
        "type": "field",
        "ip": [
          "geoip:private"
        ],
        "outboundTag": "direct"
      },
      {
        "type": "field",
        "domain": [
          "geosite:category-ads-all"
        ],
        "outboundTag": "block"
      },
      {
        "type": "field",
        "domain": [
          "geosite:category-ru",
          "geosite:category-gov-ru"
        ],
        "outboundTag": "direct"
      },
      {
        "type": "field",
        "ip": [
          "geoip:ru"
        ],
        "outboundTag": "direct"
      },
      {
        "type": "field",
        "domain": [
          "geosite:microsoft",
          "geosite:apple",
          "geosite:twitch",
          "geosite:pinterest"
        ],
        "outboundTag": "direct"
      },
      {
        "type": "field",
        "domain": [
          "geosite:steam",
          "geosite:epicgames",
          "geosite:origin",
          "geosite:ea",
          "geosite:riot"
        ],
        "outboundTag": "direct"
      },
      {
        "type": "field",
        "network": "tcp,udp",
        "balancerTag": "gates"
      }
    ],
    "balancers": [
      {
        "tag": "gates",
        "selector": [
          "ru-gate-primary",
          "ru-gate-backup",
          "kz-direct",
          "de-direct",
          "nl-direct-grpc"
        ],
        "strategy": {
          "type": "leastPing"
        }
      }
    ]
  },
  "observatory": {
    "subjectSelector": [
      "ru-gate",
      "kz-",
      "de-",
      "nl-"
    ],
    "probeURL": "https://speed.cloudflare.com/__down?bytes=100000",
    "probeInterval": "15m",
    "enableConcurrency": false
  }
}
